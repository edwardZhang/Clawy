{
    "name": "clawy",
    "version": "0.3.13",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@whiskeysockets/baileys",
            "esbuild",
            "node-llama-cpp",
            "protobufjs",
            "sharp"
        ]
    },
    "description": "Clawy - Graphical AI Assistant based on OpenClaw",
    "author": "Clawy Team",
    "license": "MIT",
    "private": true,
    "scripts": {
        "init": "pnpm install",
        "dev": "tauri dev",
        "dev:web": "vite",
        "dev:tauri": "tauri dev",
        "build": "pnpm run build:tauri",
        "build:web": "vite build",
        "build:tauri": "zx scripts/run-tauri-build.mjs --mode=lite",
        "build:tauri:full": "zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json",
        "build:vite": "vite build",
        "bridge:smoke": "node scripts/bridge-smoke-test.mjs",
        "bundle:openclaw-plugins": "zx scripts/bundle-openclaw-plugins.mjs",
        "bundle:clawhub": "zx scripts/bundle-clawhub.mjs",
        "lint": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "uv:download": "zx scripts/download-bundled-uv.mjs",
        "node:prepare": "zx scripts/prepare-bundled-node.mjs",
        "uv:download:mac": "zx scripts/download-bundled-uv.mjs --platform=mac",
        "uv:download:win": "zx scripts/download-bundled-uv.mjs --platform=win",
        "uv:download:linux": "zx scripts/download-bundled-uv.mjs --platform=linux",
        "uv:download:all": "zx scripts/download-bundled-uv.mjs --all",
    "icons": "zx scripts/generate-icons.mjs",
        "release:preflight": "node scripts/check-version-sync.mjs && node scripts/release-preflight.mjs",
    "package": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles app",
    "package:full": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json --bundles app",
        "package:mac": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles app",
        "package:mac:full": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json --bundles app",
        "package:mac:dmg": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles dmg",
        "package:mac:dmg:adhoc": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles dmg --sign=adhoc",
        "package:mac:dmg:signed": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles dmg --sign=developer-id",
        "package:mac:dmg:notarized": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles dmg --sign=developer-id --notarize",
        "package:win": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles nsis,msi",
        "package:win:full": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json --bundles nsis,msi",
        "package:win:nsis": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles nsis",
        "package:win:nsis:full": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json --bundles nsis",
        "package:win:msi": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=lite --bundles msi",
        "package:win:msi:full": "pnpm run release:preflight && zx scripts/run-tauri-build.mjs --mode=full --config src-tauri/tauri.full.conf.json --bundles msi",
        "release": "pnpm run build:tauri",
        "tauri": "tauri",
        "version:check": "node scripts/check-version-sync.mjs",
        "version:bump": "node scripts/bump-app-version.mjs patch",
        "version:patch": "node scripts/bump-app-version.mjs patch",
        "version:minor": "node scripts/bump-app-version.mjs minor",
        "version:major": "node scripts/bump-app-version.mjs major",
        "update:manifest": "node scripts/generate-update-manifest.mjs",
        "oss:upload": "node scripts/upload-oss-file.mjs",
        "postversion": "git push && git push --tags"
    },
    "dependencies": {
        "@icons-pack/react-simple-icons": "^13.12.0",
        "@tauri-apps/api": "^2.10.1",
        "@tauri-apps/plugin-dialog": "^2.6.0",
        "@tauri-apps/plugin-opener": "^2.5.3",
        "@tauri-apps/plugin-shell": "^2.3.5",
        "clawhub": "^0.5.0",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1.2.15",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@soimy/dingtalk": "^3.1.4",
        "@tauri-apps/cli": "^2.10.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.3.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.24",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "framer-motion": "^12.34.2",
        "globals": "^17.3.0",
        "i18next": "^25.8.11",
        "jsdom": "^28.1.0",
        "lucide-react": "^0.563.0",
        "openclaw": "2026.3.2",
        "png2icons": "^2.0.1",
        "postcss": "^8.5.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-i18next": "^16.5.4",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.13.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.34.5",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "zustand": "^5.0.11",
        "zx": "^8.8.5"
    },
    "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
