        "matrix": {
            "description": "Connect to Matrix protocol",
            "docsUrl": "https://docs.openclaw.ai/channels/matrix",
            "fields": {
                "homeserver": {
                    "label": "Homeserver URL",
                    "placeholder": "https://matrix.org"
