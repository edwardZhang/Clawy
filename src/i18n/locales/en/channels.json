    "meta": {
        "qqbot": {
            "description": "Connect QQ Open Platform bot via the openclaw-china plugin",
            "docsUrl": "https://github.com/BytePioneer-AI/openclaw-china",
            "fields": {
                "appId": {
                    "label": "App ID",
                    "placeholder": "QQ bot App ID"
                },
                "clientSecret": {
                    "label": "Client Secret",
                    "placeholder": "QQ bot Client Secret"
                },
                "dmPolicy": {
                    "label": "Direct message policy",
                    "description": "Choose who can start a QQ DM with the bot."
                },
                "allowFrom": {
                    "label": "DM allowlist",
                    "placeholder": "user_openid_1\nuser_openid_2",
                    "description": "One sender identifier per line. Used with Allowlist mode."
                },
                "groupPolicy": {
                    "label": "Group policy",
                    "description": "Control whether the bot responds in QQ groups."
                },
                "groupAllowFrom": {
                    "label": "Group allowlist",
                    "placeholder": "group_openid_1\ngroup_openid_2",
                    "description": "One allowed group or session identifier per line."
                },
                "requireMention": {
                    "label": "Require mention",
                    "description": "Only answer in groups when the bot is mentioned."
                },
                "autoSendLocalPathMedia": {
                    "label": "Auto send local media",
                    "description": "Allow the plugin to detect local file paths and upload them as media."
                }
            },
            "options": {
                "boolean": {
                    "enabled": "Enabled",
                    "disabled": "Disabled"
                },
                "dmPolicy": {
                    "open": "Allow all DMs",
                    "pairing": "Pairing approval required",
                    "allowlist": "Allowlist only"
                },
                "groupPolicy": {
                    "open": "Allow all groups",
                    "allowlist": "Allowlist only",
                    "disabled": "Disable groups"
                }
            },
            "instructions": [
                "Create a bot app in QQ Open Platform and copy its App ID and Client Secret",
                "Clawy installs the openclaw-china qqbot plugin automatically when you save",
                "Choose the DM and group access policy that matches your rollout",
                "Save, restart the gateway, and test the bot in QQ"
            ]
        },
        "telegram": {
            "description": "Connect Telegram using a bot token from @BotFather",
            "docsUrl": "https://icnnp7d0dymg.feishu.cn/wiki/TjiGwxsMWi7hpDkDAQBc0ydMnEf#MEkKdqXP1orZU2x4SrFcdUHgnl1",
