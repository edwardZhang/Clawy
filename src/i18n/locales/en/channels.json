                },
                "groupAllowFrom": {
                    "label": "Allowed room senders",
                    "placeholder": "@owner:example.org",
                    "description": "Optional full Matrix user IDs allowed to trigger the bot inside rooms."
                },
                "roomReplyMode": {
                    "label": "Room reply mode",
                    "description": "Mention only is safer. Auto reply lets the bot answer every allowed room message."
                }
            },
            "options": {
                "boolean": {
                    "disabled": "Disabled",
                    "enabled": "Enabled"
                },
                "dmPolicy": {
                    "pairing": "Pairing approval required",
                    "allowlist": "Only allowlisted users",
                    "open": "Anyone can DM the bot",
                    "disabled": "Disable all DMs"
                },
                "groupPolicy": {
                    "allowlist": "Only allowlisted rooms",
                    "open": "Any room",
                    "disabled": "Disable all rooms"
                },
                "roomReplyMode": {
                    "mentionOnly": "Require mention",
                    "autoReply": "Auto reply in room"
                }
            },
            "instructions": [
                "Create a Matrix account or use existing",
                "Get an access token from your client",
                "Choose DM and room policies so the bot can reply where you expect"
            ]
        },
